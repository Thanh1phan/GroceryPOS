<?xml version="1.0" encoding="utf-8"?>
<!--
  Smaller framework-dependent build (~27 MB instead of ~75 MB) for computers that already have the
  ".NET Desktop Runtime 8.0 (x64)". The installer built from it checks for the runtime and links to the download page.
  dotnet publish src/GroceryPOS.App -p:PublishProfile=win-x64-framework   (or build/publish.ps1 -FrameworkDependent)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>vi;en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64-framework\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
