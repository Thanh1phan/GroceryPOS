<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GroceryPOS.UI.Controls.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!--
      The theme core (tokens, color math, state → color resolution) and the input core (number/date
      parsing, date presets, accent-insensitive matching) and the grid core (search/sort/paging, pager links) only depend on System.Drawing.Color and the BCL,
      so they are compiled into this cross-platform test project directly. The WinForms controls themselves
      target net8.0-windows and cannot run on the Linux test agents.
    -->
    <Compile Include="..\..\src\GroceryPOS.UI.Controls\Theming\Core\**\*.cs" LinkBase="ThemeCore" />
    <Compile Include="..\..\src\GroceryPOS.UI.Controls\Inputs\Core\**\*.cs" LinkBase="InputCore" />
    <Compile Include="..\..\src\GroceryPOS.UI.Controls\Grids\Core\**\*.cs" LinkBase="GridCore" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
